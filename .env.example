# キー名だけを書く。値は各環境（ローカルは .env.local、staging / production は Vercel の環境変数）で設定する。
# NEXT_PUBLIC_ が付くものはブラウザに公開される。シークレットには絶対に付けないこと。

# --- サイトの URL（本番ドメインは TODO(要確認)） ---
NEXT_PUBLIC_GUEST_URL=
NEXT_PUBLIC_HOST_URL=
# 運営管理の URL は利用者サイト・貸出主センターからリンクしないため、admin アプリでだけ設定する
ADMIN_URL=
# 運営管理の前段のアクセス制限: cloudflare / vercel / none（ローカルのみ）。未設定だと運営管理はすべて拒否する
ADMIN_ACCESS_MODE=
# ADMIN_ACCESS_MODE=cloudflare のとき（docs/admin-access.md）
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe（development / staging はテストモードのキー） ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- メール（Resend） ---
RESEND_API_KEY=
MAIL_FROM=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- 定期実行（Vercel Cron の認証） ---
CRON_SECRET=

# --- DB テスト（supabase/tests） ---
ADMIN_DATABASE_URL=
API_DATABASE_URL=
DB_TEST_TARGET=
